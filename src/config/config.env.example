# Copy to src/config/config.env (never commit the real file) or set these in your host's dashboard.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=
# Optional separate secret for signed KYC document links (defaults to JWT_SECRET)
FILE_URL_SECRET=

# Public URL of this API (used to build file links)
API_BASE_URL=http://localhost:5000
# Allowed browser origins (comma separated). Leave all empty only in development.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=
CORS_ORIGINS=

SMTP_HOST=
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

APP_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FORCE_SMS=false

# Wallet connect: chain ids users may link (EVM). 1=Ethereum, 56=BNB, 137=Polygon, 8453=Base, 42161=Arbitrum
WALLET_ALLOWED_CHAINS=1,56,137,8453,42161
