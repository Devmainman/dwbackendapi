{
  "name": "investment-platform-api",
  "version": "1.0.0",
  "type": "module",
  "main": "src/app.js",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "secure": "npm run bundle && javascript-obfuscator dist/app.js --output dist/app.obf.js",
    "obfuscate": "javascript-obfuscator dist/app.js --output dist/app.obf.js --config obfuscator-config.cjs",
    "start:obf": "node dist/app.obf.js",
    "seed": "node seed.js",
    "seed:mining": "node seed.js --mining",
    "seed:trading": "node scripts/seedTraders.js",
    "seed:products": "node scripts/seedProducts.js",
    "create-admin": "node scripts/createAdmin.js",
    "vercel-build": "echo \"No build step: the API runs from source on Vercel\"",
    "bundle": "esbuild src/app.js --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Backend API for Investment Platform",
  "dependencies": {
    "@vercel/blob": "^2.9.0",
    "@vercel/functions": "^2.2.13",
    "axios": "^1.21.1",
    "bcryptjs": "^2.4.3",
    "buffer-equal-constant-time": "file:vendor/buffer-equal-constant-time",
    "cloudinary": "^1.41.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ethers": "^6.13.4",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.0.1",
    "express-ws": "^5.0.2",
    "geoip-lite": "^1.4.10",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.2",
    "nodemailer": "^7.0.3",
    "qs": "^6.17.1",
    "tldjs": "^2.3.1",
    "twilio": "^5.6.0",
    "ua-parser-js": "^2.0.3",
    "useragent": "^2.3.0",
    "uuid": "^14.0.3",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": "26.x"
  },
  "overrides": {
    "buffer-equal-constant-time": "$buffer-equal-constant-time"
  }
}
